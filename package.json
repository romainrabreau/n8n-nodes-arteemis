{
	"name": "n8n-nodes-arteemis",
	"version": "0.1.4",
	"description": "arteemis for n8n: B2B outreach events as triggers, contacts, lists, campaigns, pipeline and tasks as actions.",
	"license": "MIT",
	"homepage": "https://arteemis.xyz",
	"keywords": [
		"n8n-community-node-package",
		"arteemis",
		"outreach",
		"linkedin",
		"sales"
	],
	"author": {
		"name": "arteemis",
		"email": "romain@arteemis.xyz"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/romainrabreau/n8n-nodes-arteemis.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ArteemisApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Arteemis/Arteemis.node.js",
			"dist/nodes/ArteemisTrigger/ArteemisTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.54.3",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
